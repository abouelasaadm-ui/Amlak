function saveOwner(){
  const id = document.getElementById('ow_id').value;
  const name = document.getElementById('ow_name').value.trim();
  if(!name){ toast('اكتب اسم المالك','error'); return; }

  const tartirVal = document.getElementById('ow_tartir').value;
  const taraaVal  = document.getElementById('ow_taraa').value;
  const zahraVal  = document.getElementById('ow_zahra').value;

  const o = {
    name,
    note: document.getElementById('ow_note').value.trim(),
    notes: document.getElementById('ow_notes').value.trim(),
    phone: document.getElementById('ow_phone').value.trim(),
    nationalId: document.getElementById('ow_national_id').value.trim(),
    address: document.getElementById('ow_address').value.trim(),
    customTartir: tartirVal === '' ? null : Number(tartirVal),
    customTaraa:  taraaVal  === '' ? null : Number(taraaVal),
    customZahra:  zahraVal  === '' ? null : Number(zahraVal)
  };

  if(id){
    const ow = DB.owners.find(x => x.id === id);
    if(ow) Object.assign(ow, o);
    toast('تم التعديل','success');
  } else {
    const newId = 'o' + Date.now();
    DB.owners.push({id: newId, ...o});
    if(DB.attachments['owner_temp']){
      DB.attachments[newId] = DB.attachments['owner_temp'];
      delete DB.attachments['owner_temp'];
