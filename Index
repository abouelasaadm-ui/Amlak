function sendWhatsapp(){
  const tenantId = document.getElementById('wa_tenantId').value;
  const msg = document.getElementById('wa_message').value;
  const t = DB.tenants.find(x => x.id === tenantId);
  if(!t || !t.phone){ toast('رقم غير متاح','error'); return; }

  let phone = t.phone.replace(/\D/g, '');
  if(phone.startsWith('0')) phone = '2' + phone;
  if(!phone.startsWith('20')) phone = '20' + phone;

  const url = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(msg);
  window.open(url, '_blank');
  closeModal('whatsappModal');
  toast('تم فتح واتساب','success');
}

