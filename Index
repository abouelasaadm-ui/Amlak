  const incTaraa  = calcPropertyIncome('p2');
  const incZahra  = calcPropertyIncome('p3');

  const incShops = DB.units.filter(u => u.propertyId === 'p1' && u.type === 'محل').reduce((s,u) => s + (Number(u.rent) || 0), 0);

  const unit104 = DB.units.find(u => u.id === 'u104');
  const rent104 = unit104 ? (Number(unit104.rent) || 0) : 0;

  const unit103 = DB.units.find(u => u.id === 'u103');
  const rent103 = unit103 ? (Number(unit103.rent) || 0) : 0;

  let customIncome = 0;
  DB.units.forEach(u => {
    if(u.distribution && u.distribution.length > 0 && u.rent > 0){
      const share = u.distribution.find(d => d.name === owner.name);
      if(share && share.percent > 0){
        customIncome += (u.rent * share.percent / 100);
      }
    }
  });

  if(owner.customTartir !== null && owner.customTartir !== undefined && owner.customTartir !== ''){
    return {
      tartir: Number(owner.customTartir) || 0,
      taraa: Number(owner.customTaraa) || 0,
      zahra: Number(owner.customZahra) || 0,
      customIncome,
      total: (Number(owner.customTartir)||0) + (Number(owner.customTaraa)||0) + (Number(owner.customZahra)||0) + customIncome
    };
  }

  let tartir = 0, taraa = 0, zahra = 0;
  const name = owner.name || '';

  if(name.includes('سلامة')){
    zahra = incZahra;
  } else if(name.includes('محمد صابر') || name.includes('محمد')){
    tartir = (incShops/6) + rent104;
    taraa = incTaraa * 0.25;
  } else if(name.includes('نهلة')){
    tartir = (incShops/6) + rent103;
    taraa = incTaraa * 0.125;
  } else if(name.includes('سونيا')){
    taraa = incTaraa * 0.125;
  } else if(name.includes('علا') || name.includes('نجوان') || name.includes('تهاني') || name.includes('بسمة')){
    tartir = incShops/6;
    taraa = incTaraa * 0.125;
  }

  return { 
    tartir, 
    taraa, 
    zahra, 
    customIncome,
    total: tartir + taraa + zahra + customIncome 
  };
}

