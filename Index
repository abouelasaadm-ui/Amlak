function deletePlan(id){
  const plan = DB.maintenance.find(m => m.id === id);
  if(!plan) return;
  if(!confirm('حذف خطة "'+plan.name+'" وكل دفعاتها؟')) return;

  DB.maintenancePayments.filter(pm => pm.planId === id).forEach(pm => {
    const atts = DB.attachments['planpay_' + pm.id] || [];
    atts.forEach(a => { if(a.id) deleteFile(a.id).catch(()=>{}); });
    delete DB.attachments['planpay_' + pm.id];
  });

  DB.maintenancePayments = DB.maintenancePayments.filter(pm => pm.planId !== id);
  DB.maintenance = DB.maintenance.filter(m => m.id !== id);
  saveDB();
  toast('تم الحذف','success');
  renderMaintenanceScreen();
}

