function saveExpense(){
  const caseId = document.getElementById('e_caseId').value;
  const date = document.getElementById('e_date').value;
  const amount = Number(document.getElementById('e_amount').value) || 0;
  if(!caseId || !date || amount <= 0){ toast('اكمل البيانات','error'); return; }

  DB.caseExpenses.push({
    id: 'e'+Date.now(),
    caseId, date, amount,
    type: document.getElementById('e_type').value,
    notes: document.getElementById('e_notes').value.trim()
  });

  saveDB();
  closeModal('expenseModal');
  toast('تم تسجيل النفقة','success');
  renderCasesScreen();
  if(currentCaseId === caseId) openCaseDetails(caseId);
