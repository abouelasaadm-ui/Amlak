function openLate(){
  const b = document.getElementById('lateModalBody');
  const list = [];
  DB.tenants.forEach(t => {
    if(!t.start || !t.rent) return;
    const s = new Date(t.start);
    const n = new Date();
    const m = (n.getFullYear()-s.getFullYear())*12 + (n.getMonth()-s.getMonth()) + 1;
    if(m <= 0) return;
    const paid = DB.payments.filter(p => p.tenantId === t.id).reduce((x,p) => x + Number(p.amount), 0);
    const due = m * t.rent;
    const late = due - paid;
    if(late > 0) list.push({t, m, due, paid, late});
  });
  if(list.length === 0){
    b.innerHTML = '<p style="text-align:center;color:var(--accent-dark);padding:25px;font-weight:700">✅ لا يوجد متأخرات</p>';
  } else {
    b.innerHTML = list.map(l => `
      <div style="background:#FEF2F2;border-radius:12px;padding:12px;margin-bottom:10px;border-right:5px solid var(--danger)">
        <div style="font-weight:800;color:var(--danger);font-size:14px">⚠️ ${l.t.name} — ${l.t.unit||''}</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:6px;line-height:1.7">
          الشهور: <b>${l.m}</b><br>
          المستحق: <b>${fmt(l.due)} ج</b><br>
          المدفوع: <b>${fmt(l.paid)} ج</b><br>
          <span style="color:var(--danger);font-size:15px;font-weight:800">المتأخر: ${fmt(l.late)} ج</span>
        </div>
      </div>`).join('');
  }
  openModal('lateModal');
}

