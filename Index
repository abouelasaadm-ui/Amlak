  document.getElementById('c_notes').value = '';
  document.getElementById('c_attachGrid').innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات</div>';
  openModal('caseModal');
