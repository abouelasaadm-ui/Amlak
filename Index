/* ============================================
   IndexedDB — حفظ وجلب وحذف
   ============================================ */
async function saveFile(file){
  const db = await openAttDB();
  const id = 'f' + Date.now() + '_' + Math.random().toString(36).slice(2,8);
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const tx = db.transaction('files', 'readwrite');
      const store = tx.objectStore('files');
      const record = {
        id,
        name: file.name,
        type: file.type,
        size: file.size,
        data: reader.result,
        date: new Date().toISOString()
      };
      const req = store.add(record);
      req.onsuccess = () => resolve({id, name:file.name, type:file.type, size:file.size});
      req.onerror = e => reject(e);
    };
    reader.onerror = e => reject(e);
    reader.readAsDataURL(file);
  });
}

async function getFile(id){
  if(attCache[id]) return attCache[id];
  const db = await openAttDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction('files', 'readonly');
    const req = tx.objectStore('files').get(id);
    req.onsuccess = () => {
      attCache[id] = req.result;
      resolve(req.result);
    };
    req.onerror = e => reject(e);
  });
}

async function deleteFile(id){
  delete attCache[id];
  const db = await openAttDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction('files', 'readwrite');
    const req = tx.objectStore('files').delete(id);
    req.onsuccess = () => resolve();
    req.onerror = e => reject(e);
  });
}

async function viewFile(fileId){
  const f = await getFile(fileId);
  if(!f){ toast('الملف غير موجود','error'); return; }
  if(f.type && f.type.startsWith('image/')){
    const w = window.open();
    if(w){
      w.document.write('<html dir="rtl"><head><title>'+f.name+'</title><style>body{margin:0;background:#111;display:flex;justify-content:center;align-items:center;min-height:100vh}img{max-width:100%;max-height:100vh}</style></head><body><img src="'+f.data+'"></body></html>');
    }
  } else {
    const a = document.createElement('a');
    a.href = f.data;
    a.download = f.name;
    a.click();
  }
}

/* رفع ملفات للوحدة */
async function uploadFiles(unitId){
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*,application/pdf';
  input.multiple = true;
  input.onchange = async (e) => {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;
    if(!DB.attachments[unitId]) DB.attachments[unitId] = [];
    toast('جاري رفع ' + files.length + ' ملف...', '');
    for(const file of files){
      try {
        const saved = await saveFile(file);
        DB.attachments[unitId].push({
          id: saved.id,
          name: saved.name,
          type: saved.type,
          size: saved.size
        });
      } catch(err){}
    }
    saveDB();
    toast('تم رفع ' + files.length + ' ملف', 'success');
    if(currentUnitId === unitId) renderUnitAttachGrid(unitId);
    if(document.getElementById('unitModal') && document.getElementById('unitModal').classList.contains('active')){
      renderAttachGridInModal(unitId);
    }
  };
  input.click();
}

function uploadFilesFromModal(){
