/* ============================================
   البحث الموحد
   ============================================ */
function globalSearch(query){
  if(!query || query.length < 2) return [];
  query = query.toLowerCase().trim();
  const results = [];

  DB.tenants.forEach(t => {
    if((t.name||'').toLowerCase().includes(query) || (t.phone||'').includes(query)){
      results.push({type:'tenant', icon:'👥', name:t.name, desc:t.unit||'', action:`editTenant('${t.id}')`});
    }
  });

  DB.owners.forEach(o => {
    if((o.name||'').toLowerCase().includes(query)){
      results.push({type:'owner', icon:'👤', name:o.name, desc:o.note||'', action:`editOwner('${o.id}')`});
    }
  });

  DB.units.forEach(u => {
    if((u.name||'').toLowerCase().includes(query) || (u.owner||'').toLowerCase().includes(query)){
      results.push({type:'unit', icon:'🏠', name:u.name, desc:u.owner||'', action:`openUnit('${u.id}')`});
    }
  });

  (DB.workers || []).forEach(w => {
    if((w.name||'').toLowerCase().includes(query) || (w.job||'').toLowerCase().includes(query)){
      results.push({type:'worker', icon:'👷', name:w.name, desc:w.job||'', action:`editWorker('${w.id}')`});
    }
  });

  (DB.family || []).forEach(f => {
    if((f.name||'').toLowerCase().includes(query)){
      results.push({type:'family', icon:'🌳', name:f.name, desc:f.spouse||'', action:`openFamilyMember('${f.id}')`});
    }
  });

  (DB.cars || []).forEach(c => {
    if((c.type||'').toLowerCase().includes(query) || (c.plate||'').toLowerCase().includes(query)){
      results.push({type:'car', icon:'🚗', name:c.type, desc:c.plate||'', action:`editCar('${c.id}')`});
    }
  });

  return results;
}

function openGlobalSearch(){
  const query = prompt('🔍 ابحث عن: (مستأجر، مالك، وحدة، عامل، فرد عائلة، سيارة)');
  if(!query) return;
  const results = globalSearch(query);
  if(results.length === 0){
    toast('لا يوجد نتائج','info');
    return;
  }
  let html = `<h3 style="color:var(--primary);margin-bottom:15px">نتائج البحث: ${results.length}</h3>`;
  html += results.map(r => `
    <div style="background:#F8FAFC;border-radius:10px;padding:12px;margin-bottom:8px;cursor:pointer;border:1px solid var(--border)" onclick="closeModal('contractModal'); ${r.action}">
      <div style="font-weight:800;color:var(--primary);font-size:14px">${r.icon} ${r.name}</div>
      <div style="font-size:11px;color:var(--text-muted);margin-top:3px">${r.desc}</div>
    </div>`).join('');
  document.getElementById('contractBody').innerHTML = html;
  document.querySelector('#contractModal .modal-header h3').textContent = '🔍 نتائج البحث';
  openModal('contractModal');
}

