/* اختصارات لوحة المفاتيح */
document.addEventListener('keydown', (e) => {
  if(['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName)) return;

  if(e.ctrlKey || e.metaKey){
    switch(e.key){
      case '1': e.preventDefault(); goHome(); break;
      case '2': e.preventDefault(); openChecklist(); break;
      case '3': e.preventDefault(); openNotifications(); break;
      case '4': e.preventDefault(); openOwners(); break;
      case '5': e.preventDefault(); openTenants(); break;
      case '6': e.preventDefault(); openMaintenance(); break;
      case '7': e.preventDefault(); openWorkers(); break;
      case '8': e.preventDefault(); openFamilyTree(); break;
      case '9': e.preventDefault(); openCases(); break;
      case 's': case 'S': e.preventDefault(); exportData(); break;
      case 'f': case 'F': e.preventDefault(); openGlobalSearch(); break;
      case 'h': case 'H': e.preventDefault(); openHelp(); break;
    }
  }

  if(e.key === 'F1'){
    e.preventDefault();
    openHelp();
  }
});
