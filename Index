function savePlan(){
  const id = document.getElementById('pl_id').value;
  const name = document.getElementById('pl_name').value.trim();
  if(!name){ toast('اكتب اسم الخطة','error'); return; }

  const o = {
    name,
    propertyId: document.getElementById('pl_prop').value,
    company: document.getElementById('pl_company').value.trim(),
    period: document.getElementById('pl_period').value,
    status: document.getElementById('pl_status').value,
    notes: document.getElementById('pl_notes').value.trim()
  };

  if(id){
    const plan = DB.maintenance.find(m => m.id === id);
    if(plan) Object.assign(plan, o);
    toast('تم التعديل','success');
  } else {
    DB.maintenance.push({id:'pl'+Date.now(), ...o});
    toast('تمت الإضافة','success');
  }
  saveDB();
  closeModal('planModal');
  renderMaintenanceScreen();
