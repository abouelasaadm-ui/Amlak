<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#6B2D8A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>أملاك وقضايا</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}

:root{
  --primary:#6B2D8A;
  --primary-dark:#4A1F60;
  --primary-light:#8B3FB0;
  --accent:#14B8A6;
  --accent-dark:#0F8B7D;
  --gold:#F59E0B;
  --bg:#F8FAFC;
  --card:#FFFFFF;
  --text:#1E293B;
  --text-muted:#64748B;
  --border:#E2E8F0;
  --danger:#EF4444;
  --success:#10B981;
  --shadow-sm:0 1px 3px rgba(107,45,138,.08);
  --shadow:0 4px 12px rgba(107,45,138,.1);
  --shadow-lg:0 12px 32px rgba(107,45,138,.15);
  --radius:14px;
  --radius-sm:10px;
  --radius-lg:20px;
}

html,body{height:100%}

body{
  font-family:-apple-system,BlinkMacSystemFont,'Cairo','Tajawal','Noto Sans Arabic','Segoe UI','Helvetica Neue',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  overscroll-behavior-y:contain;
  padding-bottom:env(safe-area-inset-bottom);
}

header{
  background:linear-gradient(135deg,var(--primary) 0%,var(--primary-light) 50%,var(--accent) 100%);
  color:#fff;
  padding:14px 18px;
  position:sticky;
  top:0;
  z-index:100;
  box-shadow:0 4px 20px rgba(107,45,138,.25);
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding-top:calc(14px + env(safe-area-inset-top));
}

.logo{display:flex;align-items:center;gap:10px}

.logo-icon{
  width:44px;
  height:44px;
  background:rgba(255,255,255,.15);
  backdrop-filter:blur(10px);
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  border:1px solid rgba(255,255,255,.2);
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.logo-text{
  font-size:22px;
  font-weight:800;
  letter-spacing:.5px;
  line-height:1;
}

.logo-text span{color:#FCD34D;font-weight:900}

.logo-sub{
  font-size:10px;
  opacity:.85;
  margin-top:2px;
  font-weight:500;
}

.icon-btn{
  background:rgba(255,255,255,.15);
  color:#fff;
  border:1px solid rgba(255,255,255,.2);
  width:42px;
  height:42px;
  border-radius:12px;
  font-size:18px;
  cursor:pointer;
  backdrop-filter:blur(10px);
  transition:all .2s;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}

.icon-btn:active{transform:scale(.92);background:rgba(255,255,255,.25)}

.notif-badge{
  position:absolute;
  top:2px;
  left:2px;
  background:#FCD34D;
  color:#78350F;
  font-size:10px;
  font-weight:800;
  padding:1px 5px;
  border-radius:10px;
  display:none;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:16px 14px 90px;
}

.section-title{
  font-size:17px;
  font-weight:700;
  color:var(--primary);
  margin:20px 0 12px;
  padding-right:12px;
  border-right:4px solid var(--accent);
  display:flex;
  justify-content:space-between;
  align-items:center;
  line-height:1.2;
}

.section-title .count{
  font-size:12px;
  color:var(--text-muted);
  font-weight:500;
  background:var(--card);
  padding:3px 10px;
  border-radius:20px;
  border:1px solid var(--border);
}

.month-input{
  padding:6px 10px;
  border-radius:8px;
  border:2px solid var(--border);
  font-family:inherit;
  font-size:13px;
}

.cards-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:14px;
}

.property-card{
  border-radius:var(--radius-lg);
  overflow:hidden;
  background:var(--card);
  box-shadow:var(--shadow);
  cursor:pointer;
  transition:transform .25s cubic-bezier(.4,0,.2,1),box-shadow .25s;
  position:relative;
}

.property-card:active{transform:scale(.97)}

.card-header{
  padding:20px;
  color:#fff;
  position:relative;
  overflow:hidden;
}

.card-header::before{
  content:'';
  position:absolute;
  top:-40%;
  right:-20%;
  width:180px;
  height:180px;
  border-radius:50%;
  background:rgba(255,255,255,.1);
}

.card-header::after{
  content:'';
  position:absolute;
  bottom:-30%;
  left:-10%;
  width:120px;
  height:120px;
  border-radius:50%;
  background:rgba(255,255,255,.08);
}

.card-icon{
  font-size:32px;
  margin-bottom:8px;
  position:relative;
  z-index:1;
}

.card-title{
  font-size:19px;
  font-weight:800;
  margin-bottom:4px;
  position:relative;
  z-index:1;
}

.card-sub{
  font-size:12px;
  opacity:.9;
  position:relative;
  z-index:1;
}

.card-body{padding:16px 18px}

.card-stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:12px;
}

.stat{
  text-align:center;
  padding:9px 4px;
  background:linear-gradient(135deg,#F8FAFC,#F1F5F9);
  border-radius:var(--radius-sm);
  border:1px solid var(--border);
}

.stat-num{
  font-size:16px;
  font-weight:800;
  color:var(--primary);
  line-height:1.1;
}

.stat-lbl{
  font-size:10px;
  color:var(--text-muted);
  margin-top:3px;
  font-weight:600;
}

.card-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding-top:12px;
  border-top:1px solid var(--border);
  font-size:13px;
  color:var(--text-muted);
}

.income{
  color:var(--accent-dark);
  font-weight:800;
  font-size:15px;
  background:linear-gradient(135deg,#CCFBF1,#99F6E4);
  padding:3px 10px;
  border-radius:8px;
}

.color-tartir .card-header{background:linear-gradient(135deg,#6B2D8A,#8B3FB0)}
.color-tartir .card-icon{color:#FCD34D}

.color-taraa .card-header{background:linear-gradient(135deg,#0F766E,#14B8A6)}
.color-taraa .card-icon{color:#A7F3D0}

.color-zahra .card-header{background:linear-gradient(135deg,#7C3AED,#A78BFA)}
.color-zahra .card-icon{color:#DDD6FE}

.color-maqaber .card-header{background:linear-gradient(135deg,#334155,#64748B)}
.color-maqaber .card-icon{color:#FCD34D}

.color-cases .card-header{background:linear-gradient(135deg,#B91C1C,#DC2626)}
.color-cases .card-icon{color:#FEE2E2}

.quick-actions{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(110px,1fr));
  gap:10px;
}

.quick-btn{
  background:var(--card);
  border:2px solid var(--border);
  border-radius:var(--radius);
  padding:14px 6px;
  text-align:center;
  cursor:pointer;
  transition:all .2s;
  font-size:11px;
  font-weight:700;
  color:var(--primary);
  position:relative;
  overflow:hidden;
}

.quick-btn:active{transform:scale(.95);border-color:var(--accent);background:#F0FDFA}

.quick-btn .qi{
  display:block;
  font-size:24px;
  margin-bottom:6px;
}

.modal-bg{
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:rgba(30,41,59,.6);
  backdrop-filter:blur(4px);
  display:none;
  z-index:200;
  justify-content:center;
  align-items:flex-end;
  padding:0;
  overflow-y:auto;
}

.modal-bg.active{display:flex}

.modal{
  background:var(--card);
  border-radius:20px 20px 0 0;
  width:100%;
  max-width:640px;
  margin:auto;
  overflow:hidden;
  box-shadow:0 -20px 60px rgba(0,0,0,.35);
  animation:slideUp .3s cubic-bezier(.4,0,.2,1);
  max-height:92vh;
  display:flex;
  flex-direction:column;
  padding-bottom:env(safe-area-inset-bottom);
}

@keyframes slideUp{
  from{transform:translateY(100%)}
  to{transform:translateY(0)}
}

.modal-header{
  background:linear-gradient(135deg,var(--primary),var(--primary-light));
  color:#fff;
  padding:16px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:relative;
  flex-shrink:0;
}

.modal-header h3{font-size:17px;font-weight:700}

.modal-close{
  background:rgba(255,255,255,.15);
  border:none;
  color:#fff;
  width:34px;
  height:34px;
  border-radius:50%;
  font-size:22px;
  cursor:pointer;
  line-height:1;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:300;
}

.modal-body{
  padding:18px 20px;
  overflow-y:auto;
  flex:1;
}

.modal-desc{
  margin-bottom:15px;
  color:var(--text-muted);
  font-size:13px;
  line-height:1.5;
}

.modal-sub-title{
  margin:15px 0 10px;
  color:var(--primary);
  font-size:14px;
  font-weight:800;
}

.modal-footer{
  padding:14px 20px;
  background:#F8FAFC;
  display:flex;
  gap:10px;
  justify-content:flex-end;
  flex-wrap:wrap;
  border-top:1px solid var(--border);
  flex-shrink:0;
}

.field{margin-bottom:12px}

.field label{
  display:block;
  font-size:12px;
  color:var(--text-muted);
  margin-bottom:5px;
  font-weight:700;
}

.field input,
.field select,
.field textarea{
  width:100%;
  padding:12px;
  border:2px solid var(--border);
  border-radius:var(--radius-sm);
  font-size:15px;
  background:#fff;
  font-family:inherit;
  color:var(--text);
  transition:border .2s;
}

.field input:focus,
.field select:focus,
.field textarea:focus{
  outline:none;
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(107,45,138,.1);
}

.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

.btn{
  padding:12px 20px;
  border:none;
  border-radius:var(--radius-sm);
  cursor:pointer;
  font-size:14px;
  font-weight:700;
  font-family:inherit;
  transition:all .2s;
}

.btn:active{transform:scale(.96)}

.btn-primary{
  background:linear-gradient(135deg,var(--primary),var(--primary-light));
  color:#fff;
  box-shadow:0 4px 12px rgba(107,45,138,.3);
}

.btn-gold{
  background:linear-gradient(135deg,#F59E0B,#FBBF24);
  color:#78350F;
  box-shadow:0 4px 12px rgba(245,158,11,.3);
}

.btn-red{
  background:linear-gradient(135deg,#DC2626,#EF4444);
  color:#fff;
}

.btn-green{
  background:linear-gradient(135deg,var(--accent-dark),var(--accent));
  color:#fff;
  box-shadow:0 4px 12px rgba(20,184,166,.3);
}

.btn-ghost{
  background:#F1F5F9;
  color:var(--primary);
  border:2px solid var(--border);
}

.btn-block{width:100%}
.btn-sm{padding:7px 13px;font-size:12px}

table{width:100%;border-collapse:collapse;font-size:13px}

th,td{
  padding:10px 8px;
  border-bottom:1px solid var(--border);
  text-align:right;
}

th{
  background:#F1F5F9;
  color:var(--primary);
  font-weight:800;
  font-size:12px;
}

tr:active td{background:#F8FAFC}

.badge{
  display:inline-block;
  padding:3px 10px;
  border-radius:20px;
  font-size:10px;
  font-weight:800;
  letter-spacing:.3px;
}

.badge-green{background:#D1FAE5;color:#065F46}
.badge-gold{background:#FEF3C7;color:#92400E}
.badge-blue{background:#DBEAFE;color:#1E40AF}
.badge-gray{background:#E2E8F0;color:#475569}
.badge-red{background:#FEE2E2;color:#991B1B}
.badge-purple{background:#EDE9FE;color:#6B2D8A}

.toast{
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%) translateY(100px);
  background:var(--primary-dark);
  color:#fff;
  padding:14px 24px;
  border-radius:12px;
  font-size:14px;
  font-weight:600;
  box-shadow:var(--shadow-lg);
  z-index:300;
  opacity:0;
  transition:all .35s cubic-bezier(.4,0,.2,1);
  pointer-events:none;
  max-width:90vw;
  text-align:center;
}

.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.error{background:linear-gradient(135deg,#991B1B,#DC2626)}
.toast.success{background:linear-gradient(135deg,#065F46,#10B981)}

.screen{display:none}

.screen.active{
  display:block;
  animation:fadeIn .3s ease;
}

@keyframes fadeIn{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:translateY(0)}
}

.unit-item{
  background:var(--card);
  border-radius:var(--radius);
  padding:14px;
  margin-bottom:10px;
  border-right:5px solid var(--primary);
  box-shadow:var(--shadow-sm);
  cursor:pointer;
  transition:all .2s;
}

.unit-item:active{transform:scale(.98);box-shadow:var(--shadow)}

.unit-title{
  font-weight:800;
  font-size:15px;
  color:var(--primary);
  margin-bottom:8px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
}

.unit-info{
  font-size:12px;
  color:var(--text-muted);
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  font-weight:600;
}

.unit-notes{
  font-size:11px;
  color:var(--text-muted);
  margin-top:8px;
  padding-top:8px;
  border-top:1px dashed var(--border);
  line-height:1.5;
}

.back-btn{
  background:var(--card);
  color:var(--primary);
  border:2px solid var(--border);
  padding:9px 18px;
  border-radius:var(--radius-sm);
  cursor:pointer;
  font-size:13px;
  margin-bottom:14px;
  font-weight:700;
  font-family:inherit;
}

.back-btn:active{transform:scale(.96);background:#F1F5F9}

.detail-section{
  background:var(--card);
  border-radius:var(--radius);
  padding:16px;
  margin-bottom:12px;
  box-shadow:var(--shadow-sm);
}

.detail-section h4{
  color:var(--primary);
  font-size:14px;
  margin-bottom:12px;
  padding-bottom:8px;
  border-bottom:2px solid var(--accent);
  font-weight:800;
  display:flex;
  align-items:center;
  gap:6px;
}

.detail-row{
  display:flex;
  justify-content:space-between;
  padding:8px 0;
  font-size:13px;
  border-bottom:1px dashed var(--border);
}

.detail-row:last-child{border-bottom:none}
.detail-row .lbl{color:var(--text-muted);font-weight:600}
.detail-row .val{font-weight:800;color:var(--text)}

.owner-card{
  background:var(--card);
  border-radius:var(--radius);
  padding:18px;
  margin-bottom:12px;
  box-shadow:var(--shadow);
  border-right:5px solid var(--gold);
  position:relative;
  overflow:hidden;
}

.owner-card::before{
  content:'';
  position:absolute;
  top:-30px;
  left:-30px;
  width:100px;
  height:100px;
  border-radius:50%;
  background:linear-gradient(135deg,rgba(245,158,11,.08),rgba(20,184,166,.08));
}

.owner-name{
  font-size:17px;
  font-weight:800;
  color:var(--primary);
  margin-bottom:4px;
  position:relative;
}

.owner-total{
  font-size:22px;
  font-weight:900;
  background:linear-gradient(135deg,var(--accent-dark),var(--accent));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  margin:8px 0;
  position:relative;
}

.owner-breakdown{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(130px,1fr));
  gap:8px;
  margin-top:10px;
  position:relative;
}

.owner-brk{
  background:linear-gradient(135deg,#F8FAFC,#F1F5F9);
  border-radius:var(--radius-sm);
  padding:10px;
  text-align:center;
  border:1px solid var(--border);
}

.owner-brk .p{font-size:10px;color:var(--text-muted);font-weight:700}
.owner-brk .v{font-size:14px;font-weight:800;color:var(--primary);margin-top:3px}

.attach-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(130px,1fr));
  gap:10px;
  margin-top:10px;
}

.attach-thumb{
  background:#F8FAFC;
  border-radius:var(--radius-sm);
  padding:8px;
  text-align:center;
  font-size:11px;
  position:relative;
  border:1px solid var(--border);
  overflow:hidden;
}

.attach-thumb img{
  width:100%;
  height:100px;
  object-fit:cover;
  border-radius:6px;
  cursor:pointer;
  display:block;
}

.attach-thumb .pdf-icon{
  font-size:44px;
  color:#DC2626;
  padding:20px 0;
  cursor:pointer;
}

.attach-thumb .nm{
  display:block;
  margin-top:6px;
  color:var(--text-muted);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-weight:600;
  font-size:10px;
}

.attach-thumb .del{
  position:absolute;
  top:4px;
  left:4px;
  background:linear-gradient(135deg,#991B1B,#DC2626);
  color:#fff;
  border:none;
  width:24px;
  height:24px;
  border-radius:50%;
  font-size:14px;
  cursor:pointer;
  line-height:1;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 2px 6px rgba(0,0,0,.2);
}

.upload-zone{
  border:2px dashed var(--primary);
  border-radius:var(--radius-sm);
  padding:20px;
  text-align:center;
  cursor:pointer;
  background:linear-gradient(135deg,#F5F3FF,#ECFEFF);
  color:var(--primary);
  font-weight:700;
  font-size:13px;
  transition:all .2s;
}

.upload-zone:active{
  transform:scale(.98);
  background:linear-gradient(135deg,#EDE9FE,#CFFAFE);
}

.upload-zone .uz-icon{
  font-size:32px;
  display:block;
  margin-bottom:6px;
}

.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:rgba(255,255,255,.95);
  backdrop-filter:blur(20px);
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-around;
  align-items:center;
  padding:8px 6px;
  padding-bottom:calc(8px + env(safe-area-inset-bottom));
  z-index:99;
  box-shadow:0 -4px 20px rgba(0,0,0,.05);
}

.bnav-btn{
  flex:1;
  background:none;
  border:none;
  cursor:pointer;
  padding:8px 4px;
  text-align:center;
  font-size:10px;
  font-weight:700;
  color:var(--text-muted);
  transition:all .2s;
  border-radius:var(--radius-sm);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:3px;
  font-family:inherit;
}

.bnav-btn .bi{font-size:22px;line-height:1}
.bnav-btn:active{background:#F1F5F9;transform:scale(.95)}
.bnav-btn.active{color:var(--primary)}

.progress-bar{
  height:8px;
  background:#E2E8F0;
  border-radius:10px;
  overflow:hidden;
  margin-top:10px;
}

.progress-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--primary));
  border-radius:10px;
  transition:width .4s ease;
}

.notification-item{
  background:var(--card);
  border-radius:var(--radius);
  padding:14px;
  margin-bottom:10px;
  border-right:5px solid;
  box-shadow:var(--shadow-sm);
  display:flex;
  gap:12px;
  align-items:flex-start;
}

.notification-item.warning{border-color:var(--danger);background:linear-gradient(135deg,#FEF2F2,#FEE2E2)}
.notification-item.info{border-color:var(--accent);background:linear-gradient(135deg,#F0FDFA,#CCFBF1)}
.notification-item.gold{border-color:var(--gold);background:linear-gradient(135deg,#FFFBEB,#FEF3C7)}

.notification-item .ni-icon{font-size:24px;flex-shrink:0}
.notification-item .ni-body{flex:1}
.notification-item .ni-title{font-weight:800;font-size:13px;color:var(--text);margin-bottom:3px}
.notification-item .ni-desc{font-size:12px;color:var(--text-muted);line-height:1.5}

.check-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  background:var(--card);
  border-radius:var(--radius-sm);
  margin-bottom:8px;
  box-shadow:var(--shadow-sm);
  border-right:5px solid var(--border);
}

.check-row.paid{border-color:var(--success);background:linear-gradient(135deg,#F0FDF4,#DCFCE7)}
.check-row.unpaid{border-color:var(--danger);background:linear-gradient(135deg,#FEF2F2,#FEE2E2)}

.check-info{flex:1}
.check-name{font-weight:800;font-size:14px;color:var(--text)}
.check-sub{font-size:11px;color:var(--text-muted);margin-top:2px}
.check-actions{display:flex;gap:6px;align-items:center}

.check-btn{
  width:44px;
  height:44px;
  border-radius:50%;
  border:none;
  cursor:pointer;
  font-size:22px;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .2s;
}

.check-btn.unchecked{background:#F1F5F9;color:#94A3B8;border:2px solid var(--border)}
.check-btn.checked{background:linear-gradient(135deg,var(--success),#34D399);color:#fff;box-shadow:0 4px 12px rgba(16,185,129,.35)}
.check-btn:active{transform:scale(.9)}

.id-status{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 12px;
  border-radius:20px;
  font-size:12px;
  font-weight:800;
}

.id-status.valid{background:#D1FAE5;color:#065F46}
.id-status.warning{background:#FEF3C7;color:#92400E}
.id-status.expired{background:#FEE2E2;color:#991B1B}
.id-status.unknown{background:#E2E8F0;color:#475569}

.wa-btns{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:10px;
}

.wa-btn{
  padding:10px 12px;
  border-radius:var(--radius-sm);
  font-size:12px;
  font-weight:800;
  border:none;
  cursor:pointer;
  font-family:inherit;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  transition:all .2s;
}

.wa-btn:active{transform:scale(.96)}

.wa-reminder{
  background:linear-gradient(135deg,#DC2626,#EF4444);
  color:#fff;
  box-shadow:0 4px 12px rgba(220,38,38,.3);
}

.wa-receipt{
  background:linear-gradient(135deg,#065F46,#10B981);
  color:#fff;
  box-shadow:0 4px 12px rgba(16,185,129,.3);
}

.family-tree{padding:14px 0}

.family-gen{margin-bottom:20px;position:relative}

.family-gen-title{
  font-size:13px;
  font-weight:800;
  color:var(--primary);
  margin-bottom:10px;
  padding-right:10px;
  border-right:3px solid var(--accent);
}

.family-cards{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
  gap:10px;
}

.family-card{
  background:var(--card);
  border-radius:var(--radius-sm);
  padding:12px 8px;
  text-align:center;
  box-shadow:var(--shadow-sm);
  border:2px solid var(--border);
  cursor:pointer;
  transition:all .2s;
  position:relative;
}

.family-card:active{transform:scale(.95)}
.family-card.male{border-color:#3B82F6}
.family-card.female{border-color:#EC4899}
.family-card.deceased{opacity:.7;border-color:var(--text-muted)}
.family-card .fc-icon{font-size:32px;margin-bottom:6px;display:block}
.family-card .fc-name{font-size:12px;font-weight:800;color:var(--text);line-height:1.3}
.family-card .fc-info{font-size:10px;color:var(--text-muted);margin-top:4px}
.family-card .fc-dead-badge{
  position:absolute;top:4px;left:4px;
  background:#475569;color:#fff;
  font-size:9px;padding:2px 6px;border-radius:8px;font-weight:700;
}

.case-card{
  background:var(--card);
  border-radius:var(--radius);
  padding:16px;
  margin-bottom:12px;
  box-shadow:var(--shadow-sm);
  border-right:5px solid var(--danger);
  cursor:pointer;
  transition:all .2s;
}

.case-card:active{transform:scale(.98)}
.case-card h3{color:var(--danger);font-size:15px;margin-bottom:6px}
.case-card .cc-info{font-size:12px;color:var(--text-muted);line-height:1.7}
.case-card .cc-total{
  margin-top:10px;
  padding-top:10px;
  border-top:1px dashed var(--border);
  font-size:13px;
  font-weight:800;
  color:var(--danger);
}

.worker-card{
  background:var(--card);
  border-radius:var(--radius);
  padding:14px;
  margin-bottom:10px;
  box-shadow:var(--shadow-sm);
  border-right:5px solid var(--gold);
}

.worker-card h3{color:var(--primary);font-size:14px;margin-bottom:6px}
.worker-card .wc-info{font-size:12px;color:var(--text-muted);line-height:1.7}
.worker-card .wc-rating{color:var(--gold);font-size:14px;margin-top:6px}

.plan-card{
  background:var(--card);
  border-radius:var(--radius);
  padding:14px;
  margin-bottom:10px;
  box-shadow:var(--shadow-sm);
  border-right:5px solid var(--primary);
}

.plan-card h3{color:var(--primary);font-size:14px;margin-bottom:6px}
.plan-card .pc-info{font-size:12px;color:var(--text-muted);line-height:1.7}

.install-banner{
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;
  padding:14px 18px;
  border-radius:var(--radius);
  margin-bottom:14px;
  display:none;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  box-shadow:var(--shadow-lg);
}

.install-banner.show{display:flex}
.install-banner .ib-txt{font-size:13px;font-weight:700;line-height:1.4}

.contract-preview{
  background:#fff;
  color:#000;
  padding:20px;
  border-radius:var(--radius);
  font-family:'Times New Roman','Cairo',serif;
  line-height:2;
