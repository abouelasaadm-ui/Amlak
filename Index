function openPropertyImages(propId){
  const p = DB.properties.find(x => x.id === propId);
  if(!p) return;
  document.getElementById('propImgTitle').textContent = 'صور ' + p.name;
  document.getElementById('pi_propId').value = propId;
  renderPropertyImages(propId);
  openModal('propertyImagesModal');
}

async function renderPropertyImages(propId){
  const p = DB.properties.find(x => x.id === propId);
  if(!p) return;
  const el = document.getElementById('pi_gallery');
  const imgs = p.images || [];
  if(imgs.length === 0){
    el.innerHTML = '<div style="font-size:13px;color:var(--text-muted);padding:12px 0;grid-column:1/-1;text-align:center">لا يوجد صور بعد</div>';
    return;
  }
  let html = '';
  for(let i=0; i<imgs.length; i++){
    const img = imgs[i];
    try {
      const f = await getFile(img.id);
      if(f && f.data){
        html += `<div class="attach-thumb">
          <button class="del" onclick="removePropertyImage('${propId}',${i})">×</button>
          <img src="${f.data}" onclick="viewFile('${img.id}')" alt="${img.name}">
        </div>`;
      }
    } catch(e){}
  }
  el.innerHTML = html;
}

async function uploadPropertyImages(){
  const propId = document.getElementById('pi_propId').value;
  const p = DB.properties.find(x => x.id === propId);
  if(!p) return;

  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*';
  input.multiple = true;
  input.onchange = async (e) => {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;
    if(!p.images) p.images = [];
    toast('جاري رفع ' + files.length + ' صورة...', '');
    for(const file of files){
      try {
        const saved = await saveFile(file);
        p.images.push({id:saved.id, name:saved.name, type:saved.type});
      } catch(err){}
    }
    saveDB();
    toast('تم رفع ' + files.length + ' صورة', 'success');
    renderPropertyImages(propId);
    renderHome();
  };
  input.click();
}

async function removePropertyImage(propId, idx){
  const p = DB.properties.find(x => x.id === propId);
  if(!p || !p.images) return;
  if(!confirm('تأكيد حذف الصورة؟')) return;
  const img = p.images[idx];
  if(img && img.id){
    try { await deleteFile(img.id); } catch(e){}
  }
  p.images.splice(idx, 1);
  saveDB();
  toast('تم حذف الصورة','success');
  renderPropertyImages(propId);
  renderHome();
}

