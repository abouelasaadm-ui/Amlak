  const atts = DB.attachments['family_' + id] || [];
  atts.forEach(a => { if(a.id) deleteFile(a.id).catch(()=>{}); });
  delete DB.attachments['family_' + id];

  DB.family.forEach(x => {
    if(x.fatherId === id) x.fatherId = null;
    if(x.motherId === id) x.motherId = null;
