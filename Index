function saveCar(){
  const id = document.getElementById('car_id').value;
  const type = document.getElementById('car_type').value.trim();
  const plate = document.getElementById('car_plate').value.trim();
  if(!type || !plate){ toast('اكتب نوع السيارة ورقم اللوحة','error'); return; }

  const o = {
    type, plate,
    color: document.getElementById('car_color').value.trim(),
    year: document.getElementById('car_year').value,
    chassis: document.getElementById('car_chassis').value.trim(),
    motor: document.getElementById('car_motor').value.trim(),
    owner: document.getElementById('car_owner').value,
    licenseExpiry: document.getElementById('car_license_expiry').value,
    insuranceExpiry: document.getElementById('car_insurance_expiry').value,
    drivingExpiry: document.getElementById('car_driving_expiry').value,
    notes: document.getElementById('car_notes').value.trim()
  };

  if(id){
    const c = DB.cars.find(x => x.id === id);
    if(c) Object.assign(c, o);
    toast('تم التعديل','success');
  } else {
    const newId = 'car' + Date.now();
    DB.cars.push({id: newId, ...o});
    if(DB.attachments['car_temp']){
      DB.attachments[newId] = DB.attachments['car_temp'];
      delete DB.attachments['car_temp'];
    }
    toast('تمت الإضافة','success');
  }
  saveDB();
  closeModal('carModal');
  renderCarsScreen();
}

function deleteCar(){
  const id = document.getElementById('car_id').value;
  if(!id) return;
  if(!confirm('حذف السيارة؟')) return;
  const atts = DB.attachments['car_' + id] || [];
  atts.forEach(a => { if(a.id) deleteFile(a.id).catch(()=>{}); });
  delete DB.attachments['car_' + id];
  DB.cars = DB.cars.filter(x => x.id !== id);
  saveDB();
  closeModal('carModal');
  toast('تم الحذف','success');
  renderCarsScreen();
}

async function uploadCarFile(){
  let carId = document.getElementById('car_id').value;
  if(!carId){
    carId = 'car_temp';
    document.getElementById('car_id').value = carId;
  }
  const key = 'car_' + carId;
  if(!DB.attachments[key]) DB.attachments[key] = [];

  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*,application/pdf';
  input.multiple = true;
  input.onchange = async (e) => {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;
    for(const file of files){
      try {
        const saved = await saveFile(file);
        DB.attachments[key].push({
          id: saved.id, name: saved.name, type: saved.type, size: saved.size
        });
      } catch(err){}
    }
    saveDB();
    toast('تم رفع ' + files.length + ' ملف','success');
    renderCarAttachGrid(carId);
  };
  input.click();
}

async function renderCarAttachGrid(carId){
  const el = document.getElementById('car_attachGrid');
  if(!el) return;
  const key = 'car_' + carId;
  const atts = DB.attachments[key] || [];
  if(atts.length === 0){
    el.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات</div>';
    return;
  }
  let html = '';
  for(let i=0; i<atts.length; i++){
    const a = atts[i];
    const isImg = a.type && a.type.startsWith('image/');
    if(isImg){
      try {
        const f = await getFile(a.id);
        if(f && f.data){
          html += `<div class="attach-thumb">
            <button class="del" onclick="removeCarFile('${carId}',${i})">×</button>
            <img src="${f.data}" onclick="viewFile('${a.id}')" alt="${a.name}">
            <span class="nm">${a.name}</span>
          </div>`;
        }
      } catch(e){}
    } else {
      html += `<div class="attach-thumb">
        <button class="del" onclick="removeCarFile('${carId}',${i})">×</button>
        <div class="pdf-icon" onclick="viewFile('${a.id}')">📄</div>
        <span class="nm">${a.name}</span>
      </div>`;
    }
  }
  el.innerHTML = html;
}

async function removeCarFile(carId, idx){
  const key = 'car_' + carId;
  if(!DB.attachments[key]) return;
  if(!confirm('حذف المرفق؟')) return;
  const att = DB.attachments[key][idx];
  if(att && att.id){ try { await deleteFile(att.id); } catch(e){} }
  DB.attachments[key].splice(idx, 1);
  saveDB();
  toast('تم الحذف','success');
  renderCarAttachGrid(carId);
}

