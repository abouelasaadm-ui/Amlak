function renderChecklist(){
  const month = document.getElementById('chkMonth').value;
  if(!month) return;

  const list = document.getElementById('checklistList');
  const summary = document.getElementById('checklistSummary');

  const tenants = DB.tenants.filter(t => t.rent > 0);
  if(tenants.length === 0){
    list.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:25px">لا يوجد مستأجرين بإيجار</p>';
    summary.innerHTML = '';
    return;
  }

  let totalDue = 0;
  let totalPaid = 0;
  let paidCount = 0;

  tenants.forEach(t => {
    totalDue += Number(t.rent);
    const monthPay = DB.payments.find(p => p.tenantId === t.id && p.month === month);
    if(monthPay){
      totalPaid += Number(monthPay.amount);
      paidCount++;
    }
  });

  const remaining = totalDue - totalPaid;
  const percent = totalDue > 0 ? Math.round((totalPaid / totalDue) * 100) : 0;

  summary.innerHTML = `
    <div class="property-card" style="cursor:default;margin-bottom:14px">
      <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px">
          <div class="stat">
            <div class="stat-num">${paidCount}/${tenants.length}</div>
            <div class="stat-lbl">تم تحصيلهم</div>
          </div>
          <div class="stat">
            <div class="stat-num" style="color:var(--accent-dark)">${fmt(totalPaid)}</div>
            <div class="stat-lbl">المحصّل</div>
          </div>
          <div class="stat">
            <div class="stat-num" style="color:var(--danger)">${fmt(remaining)}</div>
            <div class="stat-lbl">المتبقي</div>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-muted);font-weight:700;margin-bottom:5px">
          <span>نسبة التحصيل</span>
          <span>${percent}%</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" style="width:${percent}%"></div></div>
      </div>
    </div>`;

  list.innerHTML = tenants.map(t => {
    const monthPay = DB.payments.find(p => p.tenantId === t.id && p.month === month);
    const isPaid = !!monthPay;
    return `
      <div class="check-row ${isPaid?'paid':'unpaid'}">
        <div class="check-info">
          <div class="check-name">${t.name}</div>
          <div class="check-sub">${t.unit||''} — ${fmt(t.rent)} ج</div>
        </div>
        <div class="check-actions">
          <button class="check-btn ${isPaid?'checked':'unchecked'}" onclick="toggleCheck('${t.id}','${month}')">
            ${isPaid?'✓':'○'}
          </button>
        </div>
      </div>`;
  }).join('');
}

function toggleCheck(tenantId, month){
  const existing = DB.payments.find(p => p.tenantId === tenantId && p.month === month);
  if(existing){
    if(!confirm('تم التحصيل بالفعل. هل تريد إلغاء التحصيل؟')) return;
    DB.payments = DB.payments.filter(p => !(p.tenantId === tenantId && p.month === month));
    toast('تم إلغاء التحصيل','success');
  } else {
    const t = DB.tenants.find(x => x.id === tenantId);
    if(!t) return;
    DB.payments.push({
      id: 'pay'+Date.now(),
      tenantId,
      month,
      amount: Number(t.rent),
      notes: 'تحصيل سريع من Checklist',
      date: new Date().toISOString()
    });
    toast('✅ تم التحصيل','success');
  }
  saveDB();
  renderChecklist();
  updateNotifBadge();
}

