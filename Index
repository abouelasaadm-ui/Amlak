async function uploadOwnerFile(type){
  let ownerId = document.getElementById('ow_id').value;
  if(!ownerId){
    ownerId = 'owner_temp';
    document.getElementById('ow_id').value = ownerId;
  }
  const key = 'owner_' + ownerId;
  if(!DB.attachments[key]) DB.attachments[key] = [];

  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*,application/pdf';
  input.multiple = false;
  input.onchange = async (e) => {
    const file = e.target.files[0];
    if(!file) return;
    toast('جاري الرفع...', '');
    try {
      const saved = await saveFile(file);
      DB.attachments[key].push({
        id: saved.id,
        name: (type === 'id' ? '🪪 بطاقة — ' : '📄 ميلاد — ') + saved.name,
        type: saved.type,
        size: saved.size,
        category: type
      });
      saveDB();
      toast('تم الرفع','success');
      renderOwnerAttachGrid(ownerId);
    } catch(err){
      toast('فشل الرفع','error');
    }
  };
  input.click();
}

async function renderOwnerAttachGrid(ownerId){
  const el = document.getElementById('ow_attachGrid');
  if(!el) return;
  const key = 'owner_' + ownerId;
  const atts = DB.attachments[key] || [];
  if(atts.length === 0){
    el.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات</div>';
    return;
  }
  let html = '';
  for(let i=0; i<atts.length; i++){
    const a = atts[i];
    const isImg = a.type && a.type.startsWith('image/');
    if(isImg){
      try {
        const f = await getFile(a.id);
        if(f && f.data){
          html += `<div class="attach-thumb">
            <button class="del" onclick="removeOwnerFile('${ownerId}',${i})">×</button>
            <img src="${f.data}" onclick="viewFile('${a.id}')" alt="${a.name}">
            <span class="nm">${a.name}</span>
          </div>`;
        }
      } catch(e){}
    } else {
      html += `<div class="attach-thumb">
        <button class="del" onclick="removeOwnerFile('${ownerId}',${i})">×</button>
        <div class="pdf-icon" onclick="viewFile('${a.id}')">📄</div>
        <span class="nm">${a.name}</span>
      </div>`;
    }
  }
  el.innerHTML = html;
}

async function removeOwnerFile(ownerId, idx){
  const key = 'owner_' + ownerId;
  if(!DB.attachments[key]) return;
  if(!confirm('حذف المرفق؟')) return;
  const att = DB.attachments[key][idx];
  if(att && att.id){ try { await deleteFile(att.id); } catch(e){} }
  DB.attachments[key].splice(idx, 1);
  saveDB();
  toast('تم الحذف','success');
  renderOwnerAttachGrid(ownerId);
