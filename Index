function openContract(unitId){
  const u = DB.units.find(x => x.id === unitId);
  if(!u || !u.rent){ toast('الوحدة غير مؤجرة','error'); return; }

  const p = DB.properties.find(x => x.id === u.propertyId);
  const tenant = DB.tenants.find(t => t.unitId === unitId);
  const owner = DB.owners.find(o => u.owner && u.owner.includes(o.name));

  const contractNum = 'CN-' + unitId + '-' + new Date().getFullYear();
  const today = new Date().toLocaleDateString('ar-EG');

  const d = {
    contractNum,
    date: today,
    ownerName: u.owner || '—',
    ownerId: (owner && owner.nationalId) || '',
    ownerAddress: (owner && owner.address) || '',
    tenantName: tenant ? tenant.name : '—',
    tenantId: (tenant && tenant.nationalId) || '',
    tenantAddress: (tenant && tenant.address) || '',
    propertyAddress: (u.address || '') || (p ? (p.name + ' — ' + (p.address||'')) : '—'),
    unitName: u.name,
    unitArea: u.area || '—',
    startDate: u.start || '—',
    endDate: u.end || '—',
    rent: u.rent || 0,
    deposit: tenant ? (tenant.deposit || 0) : 0
  };

  const html = buildContractHTML(d);

  document.getElementById('contractBody').innerHTML = `
    <div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn btn-primary" onclick="printContract()">🖨 طباعة / PDF</button>
      <button class="btn btn-ghost" onclick="closeModal('contractModal')">إغلاق</button>
    </div>
    <div id="contractPrintArea" contenteditable="true" class="contract-preview">
      ${html}
    </div>
  `;
  document.querySelector('#contractModal .modal-header h3').textContent = '📄 عقد إيجار — ' + u.name;
  openModal('contractModal');
}

