}

async function removeAttachment(unitId, idx){
  if(!DB.attachments[unitId]) return;
  if(!confirm('تأكيد حذف المرفق؟')) return;
  const att = DB.attachments[unitId][idx];
  if(att && att.id){
    try { await deleteFile(att.id); } catch(e){}
  }
  DB.attachments[unitId].splice(idx, 1);
  saveDB();
  toast('تم حذف المرفق','success');
  if(currentUnitId === unitId) renderUnitAttachGrid(unitId);
  if(document.getElementById('unitModal') && document.getElementById('unitModal').classList.contains('active')){
    renderAttachGridInModal(unitId);
  }
}

async function renderUnitAttachGrid(unitId){
  const el = document.getElementById('unitAttachGrid');
  if(!el) return;
  const atts = DB.attachments[unitId] || [];
  if(atts.length === 0){
    el.innerHTML = '<div style="font-size:13px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات بعد</div>';
    return;
  }
  let html = '';
  for(let i=0; i<atts.length; i++){
    const a = atts[i];
    const isImg = a.type && a.type.startsWith('image/');
    if(isImg){
      try {
        const f = await getFile(a.id);
        if(f && f.data){
          html += `<div class="attach-thumb">
            <button class="del" onclick="removeAttachment('${unitId}',${i})">×</button>
            <img src="${f.data}" onclick="viewFile('${a.id}')" alt="${a.name}">
            <span class="nm" title="${a.name}">${a.name}</span>
          </div>`;
        }
      } catch(e){}
    } else {
      html += `<div class="attach-thumb">
        <button class="del" onclick="removeAttachment('${unitId}',${i})">×</button>
        <div class="pdf-icon" onclick="viewFile('${a.id}')">📄</div>
