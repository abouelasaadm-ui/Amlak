   ============================================ */
function generateNotifications(){
  const notifs = [];
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  DB.units.forEach(u => {
    if(u.end && u.rent > 0){
      const end = new Date(u.end);
      const diff = Math.floor((end - today) / (1000*60*60*24));
      if(diff >= 0 && diff <= 60){
        notifs.push({type:'warning', icon:'⏰', title:'عقد قرب ينتهي', desc:`${u.name} (${u.owner||''}) — ينتهي خلال ${diff} يوم`});
      }
      if(diff < 0){
        notifs.push({type:'warning', icon:'🔴', title:'عقد منتهي', desc:`${u.name} — انتهى منذ ${Math.abs(diff)} يوم`});
      }
    }
  });

  DB.units.forEach(u => {
    if(u.notes && u.notes.includes('من 1 ديسمبر')){
      const target = new Date(now.getFullYear(), 11, 1);
      if(target < today) target.setFullYear(target.getFullYear()+1);
      const diff = Math.floor((target - today) / (1000*60*60*24));
      if(diff >= 0 && diff <= 30){
        notifs.push({type:'gold', icon:'💰', title:'زيادة إيجار قادمة', desc:`${u.name} — زيادة خلال ${diff} يوم`});
      }
    }
  });

  DB.tenants.forEach(t => {
    if(t.idExpiry){
      const status = calcIdStatus(t.idExpiry);
      if(status.status === 'warning'){
        notifs.push({type:'gold', icon:'🪪', title:'هوية قربت تنتهي', desc:`${t.name} — ${status.text}`});
      } else if(status.status === 'expired'){
        notifs.push({type:'warning', icon:'🪪', title:'هوية منتهية', desc:`${t.name} — ${status.text}`});
      }
    }
  });

  DB.tenants.forEach(t => {
    if(!t.start || !t.rent) return;
    const s = new Date(t.start);
    const m = (now.getFullYear()-s.getFullYear())*12 + (now.getMonth()-s.getMonth()) + 1;
    if(m <= 0) return;
    const paid = DB.payments.filter(p => p.tenantId === t.id).reduce((x,p) => x + Number(p.amount), 0);
    const due = m * t.rent;
    if(due - paid > 0){
      notifs.push({type:'warning', icon:'⚠️', title:'متأخرات', desc:`${t.name} — متأخر ${fmt(due - paid)} ج`});
    }
  });

  (DB.cars || []).forEach(c => {
    const lic = calcIdStatus(c.licenseExpiry);
    const ins = calcIdStatus(c.insuranceExpiry);
    const drv = calcIdStatus(c.drivingExpiry);
    if(lic.status === 'warning' || lic.status === 'expired') notifs.push({type:'gold', icon:'🚗', title:'رخصة سيارة', desc:`${c.type} ${c.plate} — ${lic.text}`});
    if(ins.status === 'warning' || ins.status === 'expired') notifs.push({type:'gold', icon:'🛡', title:'تأمين سيارة', desc:`${c.type} ${c.plate} — ${ins.text}`});
    if(drv.status === 'warning' || drv.status === 'expired') notifs.push({type:'gold', icon:'🪪', title:'رخصة قيادة', desc:`${c.type} ${c.plate} — ${drv.text}`});
  });

  DB.maintenance.forEach(plan => {
    const lastPay = DB.maintenancePayments.filter(p => p.planId === plan.id).sort((a,b) => new Date(b.date) - new Date(a.date))[0];
    if(plan.status === 'نشطة' && plan.period === 'شهري'){
      if(!lastPay){
        notifs.push({type:'gold', icon:'🔧', title:'صيانة بدون دفعات', desc:`${plan.name}`});
      } else {
        const lastDate = new Date(lastPay.date);
        const diff = Math.floor((today - lastDate) / (1000*60*60*24));
        if(diff > 45) notifs.push({type:'gold', icon:'🔧', title:'صيانة متأخرة', desc:`${plan.name} — منذ ${diff} يوم`});
      }
    }
  });

  DB.cases.forEach(c => {
    (c.sessions || []).forEach(s => {
      if(!s.next) return;
      const next = new Date(s.next);
      const diff = Math.floor((next - today) / (1000*60*60*24));
      if(diff >= 0 && diff <= 7){
        notifs.push({type:'warning', icon:'⚖️', title:'جلسة قضائية', desc:`${c.name} — خلال ${diff} يوم`});
      }
    });
  });

  (DB.notifications || []).forEach(n => {
    notifs.push({type:'info', icon:'📝', title:n.title || 'إشعار', desc:n.desc || ''});
  });

  return notifs;
}

