function editCase(id){
  const c = DB.cases.find(x => x.id === id);
  if(!c) return;
  document.getElementById('caseModalTitle').textContent = 'تعديل قضية';
  document.getElementById('c_id').value = c.id;
  document.getElementById('c_name').value = c.name || '';
  document.getElementById('c_number').value = c.number || '';
  document.getElementById('c_court').value = c.court || '';
  document.getElementById('c_lawyer').value = c.lawyer || '';
  document.getElementById('c_status').value = c.status || 'جارية';
  document.getElementById('c_notes').value = c.notes || '';
  renderCaseAttachGrid(c.id);
  openModal('caseModal');
}

function saveCase(){
  const id = document.getElementById('c_id').value;
  const name = document.getElementById('c_name').value.trim();
  if(!name){ toast('اكتب اسم القضية','error'); return; }

  const o = {
    name,
    number: document.getElementById('c_number').value.trim(),
    court: document.getElementById('c_court').value.trim(),
    lawyer: document.getElementById('c_lawyer').value.trim(),
    status: document.getElementById('c_status').value,
    notes: document.getElementById('c_notes').value.trim()
  };

  if(id){
    const c = DB.cases.find(x => x.id === id);
    if(c) Object.assign(c, o);
    toast('تم التعديل','success');
  } else {
    const newId = 'c' + Date.now();
    DB.cases.push({id: newId, ...o, expenses:[], attachments:[], sessions:[]});
    if(DB.attachments['case_temp']){
      DB.attachments[newId] = DB.attachments['case_temp'];
      delete DB.attachments['case_temp'];
    }
    toast('تمت الإضافة','success');
  }
  saveDB();
  closeModal('caseModal');
  renderCasesScreen();
}

function deleteCase(id){
  const c = DB.cases.find(x => x.id === id);
  if(!c) return;
  if(!confirm('حذف قضية "'+c.name+'" وكل مستنداتها؟')) return;

  const atts = DB.attachments['case_' + id] || [];
  atts.forEach(a => { if(a.id) deleteFile(a.id).catch(()=>{}); });
  delete DB.attachments['case_' + id];
  DB.caseExpenses = DB.caseExpenses.filter(e => e.caseId !== id);
  DB.cases = DB.cases.filter(x => x.id !== id);
  saveDB();
  toast('تم الحذف','success');
  renderCasesScreen();
}

async function uploadCaseFile(){
  let caseId = document.getElementById('c_id').value;
  if(!caseId){
    caseId = 'case_temp';
    document.getElementById('c_id').value = caseId;
  }
  const key = 'case_' + caseId;
  if(!DB.attachments[key]) DB.attachments[key] = [];

  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*,application/pdf';
  input.multiple = true;
  input.onchange = async (e) => {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;
    for(const file of files){
      try {
        const saved = await saveFile(file);
        DB.attachments[key].push({
          id: saved.id, name: saved.name, type: saved.type, size: saved.size
        });
      } catch(err){}
    }
    saveDB();
    toast('تم رفع ' + files.length + ' ملف','success');
    renderCaseAttachGrid(caseId);
  };
  input.click();
}

async function renderCaseAttachGrid(caseId){
  const el = document.getElementById('c_attachGrid');
  if(!el) return;
  const key = 'case_' + caseId;
  const atts = DB.attachments[key] || [];
  if(atts.length === 0){
    el.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات</div>';
    return;
  }
  let html = '';
  for(let i=0; i<atts.length; i++){
    const a = atts[i];
    const isImg = a.type && a.type.startsWith('image/');
    if(isImg){
      try {
        const f = await getFile(a.id);
        if(f && f.data){
          html += `<div class="attach-thumb">
            <button class="del" onclick="removeCaseFile('${caseId}',${i})">×</button>
            <img src="${f.data}" onclick="viewFile('${a.id}')" alt="${a.name}">
            <span class="nm">${a.name}</span>
          </div>`;
        }
      } catch(e){}
    } else {
      html += `<div class="attach-thumb">
        <button class="del" onclick="removeCaseFile('${caseId}',${i})">×</button>
        <div class="pdf-icon" onclick="viewFile('${a.id}')">📄</div>
        <span class="nm">${a.name}</span>
      </div>`;
    }
  }
  el.innerHTML = html;
}

async function removeCaseFile(caseId, idx){
  const key = 'case_' + caseId;
  if(!DB.attachments[key]) return;
  if(!confirm('حذف المرفق؟')) return;
  const att = DB.attachments[key][idx];
  if(att && att.id){ try { await deleteFile(att.id); } catch(e){} }
  DB.attachments[key].splice(idx, 1);
  saveDB();
  toast('تم الحذف','success');
  renderCaseAttachGrid(caseId);
}

