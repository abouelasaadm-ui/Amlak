function calcIdStatus(expiry){
  if(!expiry) return {status:'unknown', text:'غير محدد', cls:'unknown'};
  const now = new Date();
  const exp = new Date(expiry);
  const diff = Math.floor((exp - now) / (1000*60*60*24));
  if(diff < 0) return {status:'expired', text:'منتهية منذ ' + Math.abs(diff) + ' يوم', cls:'expired'};
  if(diff <= 60) return {status:'warning', text:'قربت تنتهي — باقي ' + diff + ' يوم', cls:'warning'};
  return {status:'valid', text:'سارية ✓', cls:'valid'};
}

function calcPropertyIncome(propId){
  return DB.units.filter(u => u.propertyId === propId).reduce((s,u) => s + (Number(u.rent) || 0), 0);
