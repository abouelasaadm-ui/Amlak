function deleteExpense(id){
  if(!confirm('حذف النفقة؟')) return;
  DB.caseExpenses = DB.caseExpenses.filter(e => e.id !== id);
  saveDB();
  toast('تم الحذف','success');
  renderCasesScreen();
  if(currentCaseId) openCaseDetails(currentCaseId);
}

function openAddSession(caseId){
  const c = DB.cases.find(x => x.id === caseId);
  if(!c) return;
  const date = prompt('تاريخ الجلسة (YYYY-MM-DD):', new Date().toISOString().slice(0,10));
  if(!date) return;
  const subject = prompt('موضوع الجلسة:', '') || '';
  const result = prompt('نتيجة الجلسة:', '') || '';
  const next = prompt('تاريخ الجلسة القادمة:', '') || '';
  const notes = prompt('ملاحظات:', '') || '';

  if(!c.sessions) c.sessions = [];
  c.sessions.push({date, subject, result, next, notes});
  saveDB();
  toast('تمت إضافة الجلسة','success');
  openCaseDetails(caseId);
}

function deleteSession(caseId, idx){
  if(!confirm('حذف الجلسة؟')) return;
  const c = DB.cases.find(x => x.id === caseId);
  if(!c || !c.sessions) return;
  c.sessions.splice(idx, 1);
  saveDB();
  toast('تم الحذف','success');
  openCaseDetails(caseId);
}

