async function uploadPlanPaymentFile(){
  let planPayId = document.getElementById('pp_planId').value;
  if(!planPayId){
    planPayId = 'planpay_temp';
    document.getElementById('pp_planId').value = planPayId;
  }
  const key = 'planpay_' + planPayId;
  if(!DB.attachments[key]) DB.attachments[key] = [];

  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*,application/pdf';
  input.multiple = true;
  input.onchange = async (e) => {
    const files = Array.from(e.target.files);
    if(files.length === 0) return;
    for(const file of files){
      try {
        const saved = await saveFile(file);
        DB.attachments[key].push({
          id: saved.id, name: saved.name, type: saved.type, size: saved.size
        });
      } catch(err){}
    }
    saveDB();
    toast('تم رفع ' + files.length + ' ملف','success');
    renderPlanPaymentAttach(planPayId);
  };
  input.click();
}

async function renderPlanPaymentAttach(planPayId){
  const el = document.getElementById('pp_attachGrid');
  if(!el) return;
  const key = 'planpay_' + planPayId;
  const atts = DB.attachments[key] || [];
  if(atts.length === 0){
    el.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:8px 0;grid-column:1/-1;text-align:center">لا يوجد مرفقات</div>';
    return;
  }
  let html = '';
  for(const a of atts){
    const isImg = a.type && a.type.startsWith('image/');
    if(isImg){
      const f = await getFile(a.id);
      if(f && f.data){
        html += `<div class="attach-thumb">
          <img src="${f.data}" onclick="viewFile('${a.id}')" alt="${a.name}">
          <span class="nm">${a.name}</span>
        </div>`;
      }
    } else {
      html += `<div class="attach-thumb">
        <div class="pdf-icon" onclick="viewFile('${a.id}')">📄</div>
        <span class="nm">${a.name}</span>
      </div>`;
    }
  }
  el.innerHTML = html;
}

