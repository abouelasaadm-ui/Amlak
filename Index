function openBackup(){ openModal('backupModal'); }

function exportData(){
  const backup = {
    version: '4.0',
    date: new Date().toISOString(),
    appName: 'أملاك وقضايا',
    data: DB
  };

  const blob = new Blob([JSON.stringify(backup, null, 2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'amlak-backup-' + new Date().toISOString().slice(0,10) + '.json';
  a.click();
  toast('تم تصدير النسخة','success');
}

function importData(){
  const f = document.getElementById('importFile').files[0];
  if(!f) return;
  const r = new FileReader();
  r.onload = e => {
    try {
      let imported = JSON.parse(e.target.result);
      let data = imported;

      /* دعم صيغتين: مع data أو بدونها */
      if(imported.data) data = imported.data;

      if(!data.properties) throw new Error('ملف غير صالح');
      if(!confirm('سيتم استبدال البيانات الحالية بالكامل. متأكد؟')) return;
      if(!confirm('تأكيد أخير: هل أنت متأكد ١٠٠٪؟')) return;

      DB = data;

      /* إضافة الحقول الجديدة لو ناقصة */
      if(!DB.ownership) DB.ownership = [];
      if(!DB.deceased) DB.deceased = [];
      if(!DB.notifications) DB.notifications = [];
      if(!DB.owners) DB.owners = [];
      if(!DB.family) DB.family = [];
      if(!DB.maintenance) DB.maintenance = [];
      if(!DB.maintenancePayments) DB.maintenancePayments = [];
      if(!DB.workers) DB.workers = [];
      if(!DB.cases) DB.cases = [];
      if(!DB.caseExpenses) DB.caseExpenses = [];
      if(!DB.cars) DB.cars = [];
      if(!DB.will) DB.will = [];
      if(!DB.unions) DB.unions = {};
      if(!DB.attachments) DB.attachments = {};
      if(!DB.casesPassword) DB.casesPassword = '1234';
      if(!DB.willPassword) DB.willPassword = '4321';

      /* إضافة الحقول الجديدة في الوحدات */
      DB.units.forEach(u => {
        if(u.address === undefined) u.address = '';
        if(u.elecOwner === undefined) u.elecOwner = '';
        if(u.waterOwner === undefined) u.waterOwner = '';
        if(u.gasOwner === undefined) u.gasOwner = '';
        if(u.distribution === undefined) u.distribution = null;
      });

      /* إضافة الحقول الجديدة في المستأجرين */
      DB.tenants.forEach(t => {
        if(t.nationalId === undefined) t.nationalId = '';
        if(t.address === undefined) t.address = '';
      });

      /* إضافة الحقول الجديدة في الملاك */
      DB.owners.forEach(o => {
        if(o.phone === undefined) o.phone = '';
        if(o.nationalId === undefined) o.nationalId = '';
        if(o.address === undefined) o.address = '';
      });

      /* إضافة النوع في العائلة */
      DB.family.forEach(f => {
        if(!f.gender){
          f.gender = (f.name.endsWith('ة') || f.name.endsWith('ه') || f.name.endsWith('ى')) ? 'female' : 'male';
        }
        if(!f.attachments) f.attachments = [];
      });

      saveDB();
      closeModal('backupModal');
      renderHome();
      updateNotifBadge();
      toast('تم الاستيراد بنجاح','success');
    } catch(err){
      console.error(err);
      toast('ملف غير صالح','error');
    }
  };
  r.readAsText(f);
  document.getElementById('importFile').value = '';
}

function clearAll(){
  if(!confirm('⚠️ هتتحذف كل البيانات والمرفقات! متأكد؟')) return;
  if(!confirm('تأكيد أخير: هل أنت متأكد ١٠٠٪؟')) return;

  localStorage.removeItem('amlakV4DB');

  if(attDB){
    try { indexedDB.deleteDatabase('amlakV4Files'); } catch(e){}
    attDB = null;
  }
  attCache = {};
  casesUnlocked = false;
  willUnlocked = false;

  seed();
  closeModal('backupModal');
  renderHome();
  toast('تم حذف كل البيانات','success');
}

/* ============================================
   PWA — تثبيت التطبيق
   ============================================ */
let deferredPrompt = null;

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  const banner = document.getElementById('installBanner');
  if(banner) banner.classList.add('show');
});

function installPWA(){
  if(!deferredPrompt){
    toast('التثبيت غير متاح. استخدم Chrome أو Samsung Internet', 'error');
    return;
  }
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then((choice) => {
    if(choice.outcome === 'accepted'){
      toast('🎉 تم تثبيت التطبيق!','success');
      const banner = document.getElementById('installBanner');
      if(banner) banner.classList.remove('show');
    }
    deferredPrompt = null;
  });
}

window.addEventListener('appinstalled', () => {
  toast('✅ التطبيق مثبت على جهازك!','success');
  const banner = document.getElementById('installBanner');
  if(banner) banner.classList.remove('show');
});

