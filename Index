function renderFamilyTree(){
  const el = document.getElementById('familyTreeContent');
  if(!DB.family || DB.family.length === 0){
    el.innerHTML = `
      <div style="text-align:center;padding:40px 20px;color:var(--text-muted)">
        <div style="font-size:48px;margin-bottom:15px">🌳</div>
        <div style="font-size:14px;font-weight:700;margin-bottom:8px">لا يوجد أفراد في الشجرة</div>
        <div style="font-size:12px;line-height:1.7">اضغط "+ إضافة فرد" لبدء شجرة العائلة</div>
      </div>`;
    return;
  }

  const roots = DB.family.filter(f => !f.fatherId && !f.motherId);
  let html = '<div class="family-tree">';

  if(roots.length > 0){
    html += renderFamilyGeneration('الجيل الأول', roots);
  }

  let currentLevel = roots;
  let genNum = 2;
  const genNames = ['', 'الجيل الأول', 'الجيل الثاني', 'الجيل الثالث', 'الجيل الرابع', 'الجيل الخامس', 'الجيل السادس', 'الجيل السابع', 'الجيل الثامن'];

  while(currentLevel.length > 0 && genNum <= 10){
    const children = [];
    currentLevel.forEach(parent => {
      const kids = DB.family.filter(f => f.fatherId === parent.id || f.motherId === parent.id);
      kids.forEach(k => { if(!children.includes(k)) children.push(k); });
    });
    if(children.length === 0) break;
    html += renderFamilyGeneration(genNames[genNum] || ('الجيل ' + genNum), children);
    currentLevel = children;
    genNum++;
  }

  html += '</div>';
  el.innerHTML = html;
}

function renderFamilyGeneration(title, members){
  return `
    <div class="family-gen">
      <div class="family-gen-title">${title} — ${members.length} فرد</div>
      <div class="family-cards">
        ${members.map(m => {
          const cls = (m.gender === 'female' ? 'female' : 'male') + (m.status === 'متوفى' ? ' deceased' : '');
          const icon = m.gender === 'female' ? '👩' : '👨';
          const birth = m.birth ? '📅 ' + m.birth : '';
          const deathBadge = m.status === 'متوفى' ? '<span class="fc-dead-badge">متوفى</span>' : '';
          return `
            <div class="family-card ${cls}" onclick="openFamilyMember('${m.id}')">
              ${deathBadge}
              <span class="fc-icon">${icon}</span>
              <div class="fc-name">${m.name}</div>
              ${birth ? '<div class="fc-info">'+birth+'</div>' : ''}
              ${m.spouse ? '<div class="fc-info">💍 '+m.spouse+'</div>' : ''}
            </div>`;
        }).join('')}
      </div>
    </div>`;
}

